    @jsondata:Name {value: "who_will_receive_summary"}
    1|2|3|4 whoWillReceiveSummary?;
    # A list of the meeting's invitees
    @jsondata:Name {value: "meeting_invitees"}
    GetMeetingResponseSettingsMeetingInvitee[] meetingInvitees?;
