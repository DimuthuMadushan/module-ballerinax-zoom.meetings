# The disclaimer detail
public type GetDisclaimerReportResponseDisclaimerRecord record {
    # The disclaimer type
    @jsondata:Name {value: "disclaimer_type"}
    string disclaimerType?;
    # The disclaimer's user email.
    # 
    # There are several special cases where user email display will be handled specially.
    # - The client type is *gw.pstn*. The user email will be empty.
    # - The user is guest. That is the `is_guest` is *true*. The user email will be empty.
    # -  The meeting is Zoom Event. That is the `is_zoom_event` is *true*. The user email will be masked
    @jsondata:Name {value: "user_email"}
    string userEmail?;
    # Whether the meeting is a Zoom Event
    @jsondata:Name {value: "is_zoom_event"}
    boolean isZoomEvent?;
    # Whether the user is a guest
    @jsondata:Name {value: "is_guest"}
    boolean isGuest?;
    # The disclaimer status
    @jsondata:Name {value: "disclaimer_status"}
    "Agree"|"Cancel"|"Passive Agree"|"Decline Attend" disclaimerStatus?;
    # The disclaimer's meeting ID
    @jsondata:Name {value: "meeting_id"}
    string meetingId?;
    # The user's group IDs
    @jsondata:Name {value: "group_ids"}
    string[] groupIds?;
    # The disclaimer's generated time
    string time?;
    # User login client types. When the user is a guest, the client type is empty
    @jsondata:Name {value: "client_type"}
    string clientType?;
    # The disclaimer's user name
    @jsondata:Name {value: "display_name"}
    string displayName?;
    # The disclaimer's meeting number
    @jsondata:Name {value: "meeting_number"}
    int meetingNumber?;
};

