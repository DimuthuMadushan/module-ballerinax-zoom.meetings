    #  `telephony` - Telephony only.  
    #  `voip` - VoIP only.  
    #  `thirdParty` - Third party audio conference
    "both"|"telephony"|"voip"|"thirdParty" audio = "both";
    # Authentication name set in the [authentication profile](https://support.zoom.us/hc/en-us/articles/360037117472-Authentication-Profiles-for-Meetings-and-Webinars#h_5c0df2e1-cfd2-469f-bb4a-c77d7c0cca6f)
    @jsondata:Name {value: "authentication_name"}
    string authenticationName?;
    # Whether to allow the host to pause or stop automatic cloud recording for this meeting. Only supported for cloud recording
    @jsondata:Name {value: "host_pause_stop_recording"}
    boolean hostPauseStopRecording?;
    # Whether to allow an alternative host to manage meeting cloud recordings
    @jsondata:Name {value: "alternative_host_manage_cloud_recording"}
    boolean alternativeHostManageCloudRecording?;
