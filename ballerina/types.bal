    @jsondata:Name {value: "accent_color"}
    string accentColor?;
    # The name tag's background color
    @jsondata:Name {value: "background_color"}
    string backgroundColor?;
    # The name tag's name.
    # 
    # **Note:** This value cannot exceed more than 50 characters
